# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Preserved output directories (ignore generated contents, keep folder via .gitkeep)
data/*
!data/.gitkeep

results/*
!results/.gitkeep

plots/*
!plots/.gitkeep

# VS Code & Editor settings
.vscode/
.idea/

# Documentation
docs/notes.txt

# Logs
*.log

# Jupyter scratch files
.ipynb_checkpoints/

# OS-specific junk
.DS_Store
Thumbs.db

# Environment variables & secrets
.env
*.env
src/server/.env

# Node & Next.js build artifacts
client/node_modules/
client/.next/
client/out/
src/server/node_modules/