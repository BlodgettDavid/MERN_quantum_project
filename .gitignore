# Python cache
__pycache__/

# Virtual environment (hidden folder)
.quantum-dev-env/

# VS Code settings
.vscode/

# Results and plots (generated outputs, keep folder via .gitkeep)
results/*
!results/.gitkeep

plots/*
!plots/.gitkeep

# Documentation (ignore only private notes, not whole folder)
docs/notes.txt

# Logs
*.log

# Jupyter scratch files
.ipynb_checkpoints/

# OS-specific junk
.DS_Store
Thumbs.db

# Environment variables / secrets
.env
src/server/.env

# Node dependencies
client/node_modules/
src/server/node_modules/

# Next.js build output
client/.next/